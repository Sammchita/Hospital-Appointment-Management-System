@model HospitalAppointmentSystem.ViewModels.BookAppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">Book an Appointment</h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-info">
                        Select a department, doctor, date and time
                        for your appointment.
                    </div>

                    <form asp-action="Book" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Department -->

                        <div class="mb-3">

                            <label for="departmentSelect"
                                   class="form-label">
                                Department
                            </label>

                            <select id="departmentSelect"
                                    class="form-select">

                                <option value="">
                                    -- Select Department --
                                </option>

                                @if (ViewBag.Departments != null)
                                {
                                    foreach (
                                        var department
                                        in (IEnumerable<SelectListItem>)
                                        ViewBag.Departments)
                                    {
                                        <option value="@department.Value">
                                            @department.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Doctor -->

                        <div class="mb-3">

                            <label asp-for="DoctorId"
                                   class="form-label">
                            </label>

                            <select asp-for="DoctorId"
                                    id="doctorSelect"
                                    class="form-select">

                                <option value="">
                                    -- Select Doctor --
                                </option>

                            </select>

                            <span asp-validation-for="DoctorId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Date -->

                        <div class="mb-3">

                            <label asp-for="AppointmentDate"
                                   class="form-label">
                            </label>

                            <input asp-for="AppointmentDate"
                                   type="date"
                                   class="form-control"
                                   min="@today" />

                            <span asp-validation-for="AppointmentDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Time -->

                        <div class="mb-3">

                            <label asp-for="AppointmentTime"
                                   class="form-label">
                            </label>

                            <input asp-for="AppointmentTime"
                                   type="time"
                                   class="form-control" />

                            <span asp-validation-for="AppointmentTime"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Reason -->

                        <div class="mb-3">

                            <label asp-for="Reason"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Reason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Briefly describe your reason for visiting..."></textarea>

                            <span asp-validation-for="Reason"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->

                        <button type="submit"
                                class="btn btn-primary">
                            Book Appointment
                        </button>

                        <a asp-controller="Patient"
                           asp-action="Dashboard"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .getElementById("departmentSelect")
            .addEventListener("change", async function() {

                const departmentId = this.value;

                const doctorSelect =
                    document.getElementById("doctorSelect");

                // Clear existing doctors
                doctorSelect.innerHTML =
                    '<option value="">-- Select Doctor --</option>';

                if (!departmentId) {
                    return;
                }

                try {

                    const response =
                        await fetch(
                            `/Appointment/GetDoctors?departmentId=${departmentId}`
                        );

                    if (!response.ok) {

                        alert("Unable to load doctors.");

                        return;
                    }

                    const doctors =
                        await response.json();

                    doctors.forEach(function(doctor) {

                        const option =
                            document.createElement("option");

                        option.value =
                            doctor.doctorId;

                        option.textContent =
                            doctor.fullName +
                            " - " +
                            doctor.specialization;

                        doctorSelect.appendChild(option);

                    });

                }
                catch (error) {

                    console.error(
                        "Error loading doctors:",
                        error
                    );

                    alert(
                        "An error occurred while loading doctors."
                    );

                }

            });

    </script>
}