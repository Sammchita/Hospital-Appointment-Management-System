@using HospitalAppointmentSystem.Models

@model IEnumerable<HospitalAppointmentSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Appointments</h1>

            <p class="text-muted mb-0">
                View and manage your hospital appointments.
            </p>
        </div>

        <div>
            <a asp-action="Book"
               class="btn btn-primary">

                <i class="bi bi-calendar-plus"></i>
                Book Appointment

            </a>
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success!</strong>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Error!</strong>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (!Model.Any())
    {
        <!-- No Appointments -->

        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <div class="mb-3">

                    <i class="bi bi-calendar-x"
                       style="font-size: 3rem;">
                    </i>

                </div>

                <h4>No Appointments Yet</h4>

                <p class="text-muted">
                    You don't have any appointments scheduled.
                </p>

                <a asp-action="Book"
                   class="btn btn-primary">

                    Book Your First Appointment

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- Appointment Table -->

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white py-3">

                <h4 class="mb-0">
                    Appointment History
                </h4>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-3">
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Doctor
                                </th>

                                <th>
                                    Department
                                </th>

                                <th>
                                    Reason
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var appointment in Model)
                            {
                                <tr>

                                    <!-- Date -->

                                    <td class="px-3">

                                        @appointment.AppointmentDate
                                            .ToString("yyyy-MM-dd")

                                    </td>


                                    <!-- Time -->

                                    <td>
                                        @appointment.AppointmentTime.ToString("hh\\:mm")
                                    </td>


                                    <!-- Doctor -->

                                    <td>

                                        <strong>
                                            Dr. @appointment.Doctor.FullName
                                        </strong>

                                        @if (!string.IsNullOrEmpty(
                                            appointment.Doctor.Specialization))
                                        {
                                            <br />

                                            <small class="text-muted">

                                                @appointment.Doctor.Specialization

                                            </small>
                                        }

                                    </td>


                                    <!-- Department -->

                                    <td>

                                        @appointment.Doctor
                                            .Department.Name

                                    </td>


                                    <!-- Reason -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            appointment.Reason))
                                        {
                                            @appointment.Reason
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not provided
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (appointment.Status ==
                                            AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.CheckedIn)
                                        {
                                            <span class="badge bg-info text-dark">
                                                Checked In
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Completed)
                                        {
                                             @if (appointment.Prescription != null)
    {
        <a asp-controller="Prescription"
           asp-action="Details"
           asp-route-id="@appointment.Prescription.PrescriptionId"
           class="btn btn-sm btn-primary">

            View Prescription

        </a>
    }
    else
    {
        <span class="badge bg-secondary">
            Prescription Pending
        </span>
    }
}
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td>

                                        <div class="d-flex gap-2 flex-wrap">


                                            <!-- Cancel Appointment -->

                                            @if (appointment.Status ==
                                                AppointmentStatus.Pending ||
                                                appointment.Status ==
                                                AppointmentStatus.Confirmed)
                                            {
                                                <form asp-action="Cancel"
                                                      asp-route-id="@appointment.AppointmentId"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to cancel this appointment?');">

                                                        Cancel

                                                    </button>

                                                </form>
                                            }


                                            <!-- View Prescription -->

                                            @if (appointment.Status ==
                                                AppointmentStatus.Completed)
                                            {
                                                @if (appointment.Prescription != null)
                                                {
                                                    <a asp-controller="Prescription"
                                                       asp-action="Details"
                                                       asp-route-id="@appointment.Prescription.PrescriptionId"
                                                       class="btn btn-sm btn-primary">

                                                        View Prescription

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">

                                                        Prescription Pending

                                                    </span>
                                                }
                                            }


                                            <!-- No Action -->

                                            @if (appointment.Status ==
                                                AppointmentStatus.CheckedIn ||
                                                appointment.Status ==
                                                AppointmentStatus.Cancelled)
                                            {
                                                <span class="text-muted">
                                                    —
                                                </span>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>