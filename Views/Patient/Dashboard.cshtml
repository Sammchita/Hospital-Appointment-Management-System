@model HospitalAppointmentSystem.Models.Patient

@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="container mt-4">

    <div class="row mb-4">
        <div class="col">
            <h1>Patient Dashboard</h1>
            <p class="text-muted">
                Welcome, @Model.FullName
            </p>
        </div>
    </div>

    <div class="row">

        <!-- Patient Information -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">My Information</h5>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Name:</strong>
                        @Model.FullName
                    </p>

                    <p>
                        <strong>Date of Birth:</strong>
                        @(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "Not provided")
                    </p>

                    <p>
                        <strong>Gender:</strong>
                        @Model.Gender
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        @Model.PhoneNumber
                    </p>

                    <p>
                        <strong>Address:</strong>
                        @Model.Address
                    </p>

                </div>

            </div>

        </div>

        <!-- Quick Actions -->
        <div class="col-md-6 mb-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>

                <div class="card-body">

                    <a asp-controller="Appointment"
                       asp-action="Book"
                       class="btn btn-primary mb-2 w-100">
                        Book Appointment
                    </a>

                    <a asp-controller="Appointment"
                       asp-action="Index"
                       class="btn btn-outline-primary mb-2 w-100">
                        My Appointments
                    </a>

                    <a asp-controller="Patient"
                       asp-action="Profile"
                       class="btn btn-outline-secondary w-100">
                        My Profile
                    </a>

                   

                </div>

            </div>

        </div>

    </div>

</div>