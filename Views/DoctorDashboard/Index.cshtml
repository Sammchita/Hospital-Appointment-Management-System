@model HospitalAppointmentSystem.ViewModels.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container mt-4">

    <!-- Doctor Header -->

    <div class="row mb-4">

        <div class="col">

            <h1>Doctor Dashboard</h1>

            <p class="text-muted">
                Welcome, Dr. @Model.Doctor.FullName
            </p>

        </div>

    </div>


    <!-- Doctor Information -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        My Information
                    </h5>
                </div>

                <div class="card-body">

                    <p>
                        <strong>Name:</strong>
                        @Model.Doctor.FullName
                    </p>

                    <p>
                        <strong>Specialization:</strong>
                        @Model.Doctor.Specialization
                    </p>

                    <p>
                        <strong>Qualification:</strong>
                        @Model.Doctor.Qualification
                    </p>

                    <p>
                        <strong>Department:</strong>
                        @Model.Doctor.Department?.Name
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @Model.Doctor.Email
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        @Model.Doctor.PhoneNumber
                    </p>

                </div>

            </div>

        </div>


        <!-- Today's Appointment Count -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        Today's Patients
                    </h5>
                </div>

                <div class="card-body text-center">

                    <h1>
                        @Model.TodayAppointments.Count
                    </h1>

                    <p class="text-muted">
                        Appointments today
                    </p>

                </div>

            </div>

        </div>


        <!-- Today's Date -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        Today's Date
                    </h5>
                </div>

                <div class="card-body text-center">

                    <h4>
                        @DateTime.Today.ToString("yyyy-MM-dd")
                    </h4>

                    <p class="text-muted">
                        Doctor's schedule
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Today's Appointments -->

    <div class="card shadow-sm">

        <div class="card-header">

            <h4 class="mb-0">
                Today's Appointments
            </h4>

        </div>

        <div class="card-body">

            @if (!Model.TodayAppointments.Any())
            {
                <div class="text-center py-4">

                    <h5>
                        No appointments today
                    </h5>

                    <p class="text-muted">
                        You currently have no scheduled patients.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Gender</th>
                                <th>Phone</th>
                                <th>Reason</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var appointment
                                in Model.TodayAppointments)
                            {
                                <tr>

                                    <td>
                                        @appointment.AppointmentTime
                                    </td>

                                    <td>
                                        <strong>
                                            @appointment.Patient.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @appointment.Patient.Gender
                                    </td>

                                    <td>
                                        @appointment.Patient.PhoneNumber
                                    </td>

                                    <td>
                                        @appointment.Reason
                                    </td>

                                    <td>

                                        @if (appointment.Status ==
                                            AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>