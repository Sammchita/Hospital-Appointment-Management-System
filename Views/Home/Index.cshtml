@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <div class="mb-3">
                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                        🏥 Trusted Healthcare Platform
                    </span>
                </div>

                <h1 class="hero-title">
                    Your Health,
                    <span>Our Priority.</span>
                </h1>

                <p class="hero-text mt-4">
                    Book appointments with trusted doctors,
                    manage your healthcare journey and access
                    your medical appointments from one simple platform.
                </p>

                <div class="mt-4">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Patient"))
                        {
                            <a asp-controller="Appointment"
                               asp-action="Book"
                               class="btn btn-hospital me-2">
                                📅 Book Appointment
                            </a>

                            <a asp-controller="Appointment"
                               asp-action="Index"
                               class="btn btn-outline-hospital">
                                My Appointments
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           class="btn btn-hospital me-2">
                            Get Started
                        </a>

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-outline-hospital">
                            Login
                        </a>
                    }

                </div>

            </div>

            <div class="col-lg-5 text-center mt-5 mt-lg-0">

                <div class="display-1">
                    🏥
                </div>

                <h3 class="mt-3">
                    Quality Healthcare
                </h3>

                <p class="text-muted">
                    Simple. Secure. Convenient.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- FEATURES -->

<section class="feature-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="text-primary fw-semibold">
                OUR SERVICES
            </span>

            <h2 class="mt-2">
                Healthcare made simpler
            </h2>

            <p class="text-muted">
                Everything you need to manage your appointments.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        👨‍⚕️
                    </div>

                    <h4>Trusted Doctors</h4>

                    <p>
                        Find doctors across different medical
                        departments and choose the right specialist
                        for your needs.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        📅
                    </div>

                    <h4>Easy Appointment Booking</h4>

                    <p>
                        Choose your department, doctor, date and
                        time and book your appointment in just a
                        few clicks.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        🔒
                    </div>

                    <h4>Secure & Private</h4>

                    <p>
                        Your account and appointment information
                        are protected through secure authentication
                        and role-based access.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>