@model IEnumerable<HospitalAppointmentSystem.Models.Appointment>

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Receptionist Dashboard</h1>
            <p class="text-muted mb-0">
                Manage today's hospital appointments.
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6">
                @DateTime.Today.ToString("dd MMM yyyy")
            </span>
        </div>
    </div>

    <!-- Statistics -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">
                        Today's Appointments
                    </h6>

                    <h2>
                        @ViewBag.TotalAppointments
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pending
                    </h6>

                    <h2 class="text-warning">
                        @ViewBag.PendingAppointments
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">
                        Confirmed
                    </h6>

                    <h2 class="text-success">
                        @ViewBag.ConfirmedAppointments
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">
                        Completed
                    </h6>

                    <h2 class="text-primary">
                        @ViewBag.CompletedAppointments
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <!-- Today's Appointments -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Today's Appointments
            </h4>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No appointments scheduled for today.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Department</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var appointment in Model)
                            {
                                <tr>

                                    <td>
                                        @appointment.AppointmentTime
                                        @($"{appointment.AppointmentTime.Hours:00}:{appointment.AppointmentTime.Minutes:00}")
                                    </td>

                                    <td>
                                        @appointment.Patient.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor
                                            .Department.Name
                                    </td>

                                    <td>
                                        @appointment.Reason
                                    </td>

                                    <td>

                                        @if (appointment.Status ==
                                            AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>