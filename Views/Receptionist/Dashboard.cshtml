@model HospitalAppointmentSystem.ViewModels.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="container py-4">

    <!-- Header -->

    <div class="dashboard-header">

        <div>
            <span class="text-primary fw-semibold">
                RECEPTIONIST PORTAL
            </span>

            <h1 class="dashboard-title mt-2">
                Appointment Management
            </h1>

            <p class="text-muted mb-0">
                Manage today's hospital appointments and patient check-ins.
            </p>
        </div>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- Date Filter -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="Dashboard"
                  class="row align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Appointment Date
                    </label>

                    <input type="date"
                           name="date"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary">
                        View Appointments
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-4">

        <div class="col-md-3">

            <div class="stat-card">

                <div class="stat-number">
                    @Model.TotalAppointments
                </div>

                <div class="stat-label">
                    Total Appointments
                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="stat-card">

                <div class="stat-number text-warning">
                    @Model.PendingAppointments
                </div>

                <div class="stat-label">
                    Pending
                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="stat-card">

                <div class="stat-number text-success">
                    @Model.ConfirmedAppointments
                </div>

                <div class="stat-label">
                    Confirmed
                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="stat-card">

                <div class="stat-number text-info">
                    @Model.CompletedAppointments
                </div>

                <div class="stat-label">
                    Completed
                </div>

            </div>

        </div>

    </div>


    <!-- Appointments -->

    <div class="card shadow-sm">

        <div class="card-header py-3">

            <h5 class="mb-0">
                Appointments for
                @Model.SelectedDate.ToString("MMMM dd, yyyy")
            </h5>

        </div>

        <div class="card-body p-0">

            @if (!Model.Appointments.Any())
            {
                <div class="p-5 text-center">

                    <div class="display-5 mb-3">
                        📅
                    </div>

                    <h5>
                        No appointments
                    </h5>

                    <p class="text-muted">
                        There are no appointments scheduled
                        for this date.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>

                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var appointment
                                in Model.Appointments)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @appointment.AppointmentTime
                                    </td>

                                    <td>
                                        @appointment.Patient.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor.Department.Name
                                    </td>

                                    <td>

                                        @if (appointment.Status ==
                                            AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-info">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            @if (appointment.Status ==
                                                AppointmentStatus.Pending)
                                            {
                                                <form asp-action="Confirm"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@appointment.AppointmentId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">
                                                        Confirm
                                                    </button>

                                                </form>
                                            }

                                            @if (appointment.Status ==
                                                AppointmentStatus.Confirmed)
                                            {
                                                <form asp-action="Complete"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@appointment.AppointmentId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-primary">
                                                        Complete
                                                    </button>

                                                </form>
                                            }

                                            @if (appointment.Status !=
                                                AppointmentStatus.Completed &&
                                                appointment.Status !=
                                                AppointmentStatus.Cancelled)
                                            {
                                                <form asp-action="Cancel"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@appointment.AppointmentId" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Cancel
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>