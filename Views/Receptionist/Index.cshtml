@model IEnumerable<HospitalAppointmentSystem.Models.Appointment>

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Receptionist Dashboard</h1>
        <p class="text-muted">
            Manage patient appointments
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Statistics -->

    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Appointments
                    </h6>

                    <h2>
                        @Model.Count()
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pending
                    </h6>

                    <h2 class="text-warning">
                        @Model.Count(a =>
                            a.Status ==
                            HospitalAppointmentSystem.Models.AppointmentStatus.Pending)
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Confirmed
                    </h6>

                    <h2 class="text-primary">
                        @Model.Count(a =>
                            a.Status ==
                            HospitalAppointmentSystem.Models.AppointmentStatus.Confirmed)
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">
                        Completed
                    </h6>

                    <h2 class="text-success">
                        @Model.Count(a =>
                            a.Status ==
                            HospitalAppointmentSystem.Models.AppointmentStatus.Completed)
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Appointments -->

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Appointments
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    There are currently no appointments.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Department</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var appointment in Model)
                            {
                                <tr>

                                    <td>
                                        @appointment.Patient.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor.FullName
                                    </td>

                                    <td>
                                        @appointment.Doctor.Department.Name
                                    </td>

                                    <td>
                                        @appointment.AppointmentDate
                                        .ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @appointment.AppointmentTime.Hours.ToString("D2"):
                                        @appointment.AppointmentTime.Minutes.ToString("D2")
                                    </td>

                                    <td>

                                        @if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Pending)
                                        {
                                            <form asp-action="Confirm"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.AppointmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary">
                                                    Confirm
                                                </button>

                                            </form>

                                            <form asp-action="Cancel"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.AppointmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Cancel
                                                </button>

                                            </form>
                                        }

                                        @if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Confirmed)
                                        {
                                            <form asp-action="Complete"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.AppointmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Complete
                                                </button>

                                            </form>

                                            <form asp-action="Cancel"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@appointment.AppointmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Cancel
                                                </button>

                                            </form>
                                        }

                                        @if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Completed)
                                        {
                                            <span class="text-success">
                                                Finished
                                            </span>
                                        }

                                        @if (appointment.Status ==
                                            HospitalAppointmentSystem.Models.AppointmentStatus.Cancelled)
                                        {
                                            <span class="text-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>