@model HospitalAppointmentSystem.ViewModels.ConsultationViewModel

@{
    ViewData["Title"] = "Patient Consultation";
}

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        Patient Consultation
                    </h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Patient Information -->

                    <div class="card mb-4">

                        <div class="card-header">
                            <h5 class="mb-0">
                                Patient Information
                            </h5>
                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <strong>Patient Name</strong>
                                    <p class="mb-0">
                                        @Model.PatientName
                                    </p>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <strong>Phone Number</strong>
                                    <p class="mb-0">
                                        @(Model.PhoneNumber ?? "Not provided")
                                    </p>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Appointment Information -->

                    <div class="card mb-4">

                        <div class="card-header">
                            <h5 class="mb-0">
                                Appointment Information
                            </h5>
                        </div>

                        <div class="card-body">

                            <div class="row">

                                <div class="col-md-4">
                                    <strong>Date</strong>
                                    <p>
                                        @Model.AppointmentDate.ToString("dd MMM yyyy")
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Time</strong>
                                    <p>
                                        @Model.AppointmentTime.ToString(@"hh\:mm")
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Reason</strong>
                                    <p>
                                        @(Model.Reason ?? "Not provided")
                                    </p>
                                </div>

                            </div>

                        </div>

                    </div>


                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AppointmentId" />


                        <!-- Diagnosis -->

                        <div class="mb-4">

                            <label asp-for="Diagnosis"
                                   class="form-label fw-bold">
                                Diagnosis
                            </label>

                            <textarea asp-for="Diagnosis"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter diagnosis..."></textarea>

                            <span asp-validation-for="Diagnosis"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Medicines -->

                        <div class="card mb-4">

                            <div class="card-header d-flex justify-content-between align-items-center">

                                <h5 class="mb-0">
                                    Prescription
                                </h5>

                                <button type="button"
                                        id="addMedicine"
                                        class="btn btn-success btn-sm">
                                    + Add Medicine
                                </button>

                            </div>

                            <div class="card-body">

                                <div id="medicineContainer">

                                    @for (int i = 0;
                                          i < Model.PrescriptionItems.Count;
                                          i++)
                                    {
                                        <div class="medicine-row border rounded p-3 mb-3">

                                            <div class="row">

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Medicine
                                                    </label>

                                                    <input asp-for="PrescriptionItems[i].MedicineName"
                                                           class="form-control"
                                                           placeholder="e.g. Paracetamol" />

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Dosage
                                                    </label>

                                                    <input asp-for="PrescriptionItems[i].Dosage"
                                                           class="form-control"
                                                           placeholder="e.g. 500 mg" />

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Frequency
                                                    </label>

                                                    <input asp-for="PrescriptionItems[i].Frequency"
                                                           class="form-control"
                                                           placeholder="e.g. 2 times/day" />

                                                </div>

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Duration
                                                    </label>

                                                    <input asp-for="PrescriptionItems[i].Duration"
                                                           class="form-control"
                                                           placeholder="e.g. 5 days" />

                                                </div>

                                                <div class="col-md-10 mb-3">

                                                    <label class="form-label">
                                                        Instructions
                                                    </label>

                                                    <input asp-for="PrescriptionItems[i].Instructions"
                                                           class="form-control"
                                                           placeholder="e.g. Take after meals" />

                                                </div>

                                                <div class="col-md-2 d-flex align-items-end mb-3">

                                                    <button type="button"
                                                            class="btn btn-danger removeMedicine w-100">
                                                        Remove
                                                    </button>

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Submit -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Consultation
                            </button>

                            <a asp-controller="Doctor"
                               asp-action="Dashboard"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let medicineIndex =
            @Model.PrescriptionItems.Count;

        document
            .getElementById("addMedicine")
            .addEventListener("click", function () {

                const container =
                    document.getElementById("medicineContainer");

                const row =
                    document.createElement("div");

                row.className =
                    "medicine-row border rounded p-3 mb-3";

                row.innerHTML = `
                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Medicine
                            </label>

                            <input
                                name="PrescriptionItems[${medicineIndex}].MedicineName"
                                class="form-control"
                                placeholder="e.g. Paracetamol" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Dosage
                            </label>

                            <input
                                name="PrescriptionItems[${medicineIndex}].Dosage"
                                class="form-control"
                                placeholder="e.g. 500 mg" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Frequency
                            </label>

                            <input
                                name="PrescriptionItems[${medicineIndex}].Frequency"
                                class="form-control"
                                placeholder="e.g. 2 times/day" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Duration
                            </label>

                            <input
                                name="PrescriptionItems[${medicineIndex}].Duration"
                                class="form-control"
                                placeholder="e.g. 5 days" />

                        </div>

                        <div class="col-md-10 mb-3">

                            <label class="form-label">
                                Instructions
                            </label>

                            <input
                                name="PrescriptionItems[${medicineIndex}].Instructions"
                                class="form-control"
                                placeholder="e.g. Take after meals" />

                        </div>

                        <div class="col-md-2 d-flex align-items-end mb-3">

                            <button type="button"
                                    class="btn btn-danger removeMedicine w-100">
                                Remove
                            </button>

                        </div>

                    </div>
                `;

                container.appendChild(row);

                medicineIndex++;

            });


        document
            .getElementById("medicineContainer")
            .addEventListener("click", function (event) {

                if (event.target.classList.contains("removeMedicine")) {

                    const rows =
                        document.querySelectorAll(".medicine-row");

                    if (rows.length > 1) {
                        event.target
                            .closest(".medicine-row")
                            .remove();
                    }

                }

            });

    </script>
}