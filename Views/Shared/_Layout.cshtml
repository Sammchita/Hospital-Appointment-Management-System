@using HospitalAppointmentSystem.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalAppointmentSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalAppointmentSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg hospital-navbar">
            <div class="container">

                <a class="navbar-brand hospital-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">🏥</span>
                    MediCare
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Patient"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Appointment"
                                   asp-action="Book">
                                    Book Appointment
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Appointment"
                                   asp-action="Index">
                                    My Appointments
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Doctor"
                                   asp-action="Dashboard">
                                    Doctor Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Receptionist"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Receptionist"
                                   asp-action="Dashboard">
                                    Receptionist Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    Admin Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="welcome-text">
                                Hello, @User.Identity.Name
                            </span>

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  method="post"
                                  class="ms-3">

                                <button type="submit"
                                        class="btn btn-outline-light logout-btn">
                                    Logout
                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light me-2"
                               asp-area="Identity"
                               asp-page="/Account/Login">
                                Login
                            </a>

                            <a class="btn register-btn"
                               asp-area="Identity"
                               asp-page="/Account/Register">
                                Register
                            </a>
                        }

                    </div>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="hospital-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <h5>
                        🏥 MediCare
                    </h5>

                    <p class="mb-0 opacity-75">
                        Making healthcare appointments simpler
                        and more accessible.
                    </p>

                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <p class="mb-1">
                        Hospital Appointment Management System
                    </p>

                    <small class="opacity-75">
                        © @DateTime.Now.Year MediCare. All rights reserved.
                    </small>

                </div>

            </div>

        </div>

    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
