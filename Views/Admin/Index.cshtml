@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h1>Admin Dashboard</h1>

    <p class="lead">
        Welcome to the Hospital Administration Panel.
    </p>

    <hr />

    <div class="row">

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Doctors</h5>
                <p>Manage hospital doctors.</p>
                <a href="#" class="btn btn-primary">
                    Manage Doctors
                </a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Departments</h5>
                <p>Manage departments.</p>
                <a href="#" class="btn btn-primary">
                    Manage Departments
                </a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Appointments</h5>
                <p>View all appointments.</p>
                <a href="#" class="btn btn-primary">
                    Appointments
                </a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h5>Reports</h5>
                <p>View hospital reports.</p>
                <a href="#" class="btn btn-primary">
                    Reports
                </a>
            </div>
        </div>

    </div>

</div>